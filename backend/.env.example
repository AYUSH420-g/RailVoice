# ==========================================
# RailVoice Backend Environment Template
# ==========================================

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/railvoice?appName=Cluster0
DATABASE_NAME=railvoice

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Deepgram AI Voice Engine (Flux Priya)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_VOICE_MODEL=flux-priya-en

# Voice Engine Settings (Fallback)
VOICE_SYNTH_VOICE=en-IN-NeerjaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# Live RailRadar API Key (Optional: if set, queries api.railradar.in directly; otherwise uses live Indian Railways feed)
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# External LLM Keys (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
